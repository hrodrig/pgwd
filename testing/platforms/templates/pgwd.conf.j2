# /etc/pgwd/pgwd.conf — generated by Ansible (platform testing)
# Do not edit manually on the target VM.

client: "test-{{ inventory_hostname }}"
interval: 60
dry_run: false
log_level: info

databases:
{% for db in postgres_instances %}
  - url: "{{ db.url }}"
    client: "{{ db.client | default('') }}"
    stale_age: 0
    default_threshold_percent: 80
    threshold:
      idle: 0
      levels: "75,85,95"
      stale: 0
{% endfor %}

notifications:
  loki:
    url: "http://127.0.0.1:{{ notification_mock_port | default(9999) }}/loki/api/v1/push"
    bearer_token: ""
    labels: ""
    org_id: ""
  slack:
    webhook: "http://127.0.0.1:{{ notification_mock_port | default(9999) }}/slack"
