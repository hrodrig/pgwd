# Ignore everything by default (including dotfiles).
# Only what is explicitly allowed below is tracked.

*
.*
!.gitignore
!.dockerignore
!.agents/
!.agents/**
!.cursor/
!.cursor/rules/
!.cursor/rules/*.mdc
!.goreleaser.yaml
!AGENTS.md
!CHANGELOG.md
!CODE_OF_CONDUCT.md
!CONTRIBUTING.md
!Dockerfile
!Dockerfile.release
!GNUmakefile
!LICENSE
!Makefile
!README.md
!SECURITY.md
!SPECIFICATIONS.md
!VERSION
!go.mod
!go.sum
!cmd/
!cmd/**
!internal/
!internal/**
!contrib/
!contrib/**
!tools/
!tools/**
!scripts/
!scripts/**
!docs/
!docs/***
!testing/
!testing/**
!.github/
!.github/**
# CodeQL local run (database and results; do not commit)
codeql-db/
codeql-results.sarif

# OpenBSD port: distinfo requires release tarballs; generate with `make makesum` in ports tree (not in repo)
contrib/openbsd/port/distinfo

# Generated man page (created by goreleaser before hook)
contrib/man/man1/pgwd.1.gz

# Platform test inventory (developer-specific, not committed)
testing/platforms/inventory/hosts.yml

# Never track macOS metadata
.DS_Store
**/.DS_Store
